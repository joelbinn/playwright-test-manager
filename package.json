{
  "name": "playwright-test-manager",
  "version": "0.1.0",
  "description": "Web control center for Playwright testing augmented with Playwright Test Agents over ACP",
  "type": "module",
  "bin": {
    "playwright-test-manager": "./bin/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "playwright",
    "test-agents",
    "acp",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
